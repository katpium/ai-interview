# ──────────────────────────────────────────────────────────────────────
# .env.local  —  Copy this file to .env.local and fill in your values.
#
#   cp .env.local.example .env.local
#
# ⚠️  You MUST provide your own API keys for the app to work.
# ──────────────────────────────────────────────────────────────────────

# ── Server 1 (Internal AI Model API) ─────────────────────────────────
# Base URL of Server 1. Server 2 calls this from server-side code only —
# the candidate browser must NOT call Server 1 directly.
MODEL_API_BASE_URL=http://SERVER_1_IP:8000

# ── OpenRouter API ────────────────────────────────────────────────────
# Sign up at https://openrouter.ai/ and create an API key.
# This is REQUIRED for question generation, evaluation, and embeddings.
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Models ────────────────────────────────────────────────────────────
LLM_MODEL=google/gemini-2.5-flash-lite
EMBEDDING_MODEL=openai/text-embedding-3-small

# ── LightRAG (company knowledge retrieval) ────────────────────────────
# Set to true to enable real embedding-based retrieval (requires OPENROUTER_API_KEY).
# Set to false to fall back to simple keyword matching.
LIGHTRAG_ENABLED=true

# ── Authentication (RBAC) ─────────────────────────────────────────────
# IMPORTANT: Change AUTH_SECRET to a long random string (≥32 chars).
# You can generate one with:  openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-secret-string-32chars

# Users — JSON array. Available roles: admin, recruiter, hr, technician
# See README.md for role permissions.
AUTH_USERS=[{"username":"admin","password":"change-me","role":"admin"},{"username":"recruiter","password":"change-me","role":"recruiter"},{"username":"hr","password":"change-me","role":"hr"},{"username":"technician","password":"change-me","role":"technician"}]
